{
  "name": "prisma-generator-express",
  "description": "Prisma generator for Express, Fastify, and Hono CRUD APIs with OpenAPI documentation",
  "version": "1.41.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "bin": "dist/bin.js",
  "engines": {
    "node": ">=20.0"
  },
  "scripts": {
    "build": "rm -rf dist && npx tsc",
    "dev": "npx tsc -w",
    "start": "node dist/bin.js",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "prepack": "node copy.js && npm run build"
  },
  "dependencies": {
    "@prisma/generator-helper": "7.5.0",
    "prettier": "3.6.2"
  },
  "peerDependencies": {
    "@prisma/client": ">=6.0.0",
    "express": ">=4.0.0",
    "fastify": "^5.0.0",
    "hono": ">=4.0.0",
    "prisma-guard": ">=1.0.0",
    "prisma-query-builder-ui": ">=1.1.0",
    "prisma-sql": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "prisma-guard": {
      "optional": true
    },
    "prisma-query-builder-ui": {
      "optional": true
    },
    "prisma-sql": {
      "optional": true
    }
  },
  "devDependencies": {
    "@prisma/client": "7.5.0",
    "@prisma/internals": "^7.5.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.7.2",
    "@types/prettier": "3.0.0",
    "better-sqlite3": "^12.5.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.3.3",
    "fastify": "^5.6.2",
    "hono": "^4.12.23",
    "lru-cache": "^11.2.4",
    "pino": "^10.1.0",
    "pino-pretty": "^13.0.0",
    "prisma": "7.5.0",
    "semantic-release": "^24.2.9",
    "typescript": "5.9.3",
    "vitest-mock-extended": "^3.1.0"
  },
  "homepage": "https://github.com/multipliedtwice/prisma-generator-express",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multipliedtwice/prisma-generator-express.git"
  },
  "author": "multipliedtwice",
  "keywords": [
    "prisma",
    "express",
    "fastify",
    "crud",
    "generator"
  ],
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "angular",
          "releaseRules": [
            {
              "type": "chore",
              "release": "minor"
            },
            {
              "type": "refactor",
              "release": "minor"
            }
          ]
        }
      ],
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ],
          "message": "chore(release): set `package.json` to ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}
